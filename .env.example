# Kopier denne fil til .env og udfyld de nødvendige værdier.
# Commit ALDRIG .env til Git.

# --- Database ---
DATABASE_URL=postgresql+psycopg://agentops:agentops@localhost:5432/agentops

# --- MLflow ---
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=agentops-developer-platform
MLFLOW_DISABLE_TELEMETRY=true

# --- LLM Gateway ---
# Provider brugt når intet er angivet eksplicit i requesten.
# Muligheder: "test" (deterministisk, kræver ingen API key), "anthropic", "openai"
LLM_DEFAULT_PROVIDER=test

ANTHROPIC_API_KEY=
# Modelnavne verificeret mod den installerede anthropic-python SDK (1.7.0) og
# Anthropics aktuelle modelliste — ingen dato-suffiks, det er de fulde ID'er.
ANTHROPIC_DEFAULT_MODEL=claude-opus-5
ANTHROPIC_FAST_MODEL=claude-haiku-4-5

OPENAI_API_KEY=
OPENAI_DEFAULT_MODEL=gpt-4.1
OPENAI_FAST_MODEL=gpt-4.1-mini

LLM_REQUEST_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2

# --- Agent / sikkerhed ---
# Absolut sti til det repository agenten må arbejde i (sandbox-rod).
AGENT_WORKSPACE_ROOT=./demo_repo
AGENT_MAX_TOOL_CALLS=25
AGENT_TOOL_TIMEOUT_SECONDS=30

# Hvis true, kan agenten selv udføre HIGH risk handlinger uden menneskelig godkendelse.
# Skal være false i enhver miljø, der ligner produktion.
AGENT_AUTO_APPROVE_HIGH_RISK=false

# --- MCP server ---
MCP_SERVER_HOST=127.0.0.1
MCP_SERVER_PORT=8765

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
